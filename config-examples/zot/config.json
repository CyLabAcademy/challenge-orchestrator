{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "",
    "compat": ["docker2s2"],
    "tls": {
      "cert": "/etc/zot/zot-server-cert.pem",
      "key": "/run/credentials/zot.service/zot-server-key.pem",
      "cacert": "/etc/zot/zot-ca-cert.pem"
    },
    "auth": {
      "mtls": {
        "identityAttributes": ["CommonName"]
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {
              "users": ["cmgr"],
              "actions": ["read", "create", "update", "delete"]
            },
            {
              "users": ["worker"],
              "actions": ["read"]
            }
          ],
          "defaultPolicy": [],
          "anonymousPolicy": []
        }
      }
    }
  },
  "log": {
    "level": "warning"
  }
}
